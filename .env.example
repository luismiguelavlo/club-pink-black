# PostgreSQL (Docker Compose) — drizzle-kit / seed
DATABASE_URL=postgresql://club:club_secret@localhost:5432/club_pink_black

# Nuxt runtime (maps to runtimeConfig.databaseUrl)
NUXT_DATABASE_URL=postgresql://club:club_secret@localhost:5432/club_pink_black

# nuxt-auth-utils — mínimo 32 caracteres
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-secret-key-32chars

# Seed defaults (opcional)
SEED_ADMIN_EMAIL=admin@club.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrador
SEED_USER_EMAIL=rider@club.com
SEED_USER_PASSWORD=Rider123!
SEED_USER_NAME=Rider

# Cloudinary (imágenes del admin multimedia)
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
